{
  "name": "riftlauncher",
  "version": "1.7.0-beta.10",
  "description": "RiftLauncher for Vintage Story, hosted on Tauri",
  "author": "Zaldaryon",
  "homepage": "https://github.com/StratumServer/RiftLauncher-Tauri",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:ci": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "json5": "^2.2.3",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@headlessui/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "clsx": "^2.1.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next": "^24.0.5",
    "jsdom": "^27.4.0",
    "motion": "^11.13.1",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.4",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
