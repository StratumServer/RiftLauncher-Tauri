{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/domain/**/*", "src/renderer/src/**/*", "src/renderer/src/**/*.tsx", "src/renderer/src/**/*.d.ts", "src/api.d.ts", "src/global.d.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@domain/*": ["src/domain/*"]
    }
  }
}
